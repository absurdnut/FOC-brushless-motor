			(layer "B.Paste"
				(type "Bottom Solder Paste")
			)
			(layer "B.SilkS"
				(type "Bottom Silk Screen")
			)
			(copper_finish "None")
			(dielectric_constraints yes)
		)
		(pad_to_mask_clearance 0.05)
		(allow_soldermask_bridges_in_footprints yes)
		(pcbplotparams
			(layerselection 0x00010fc_ffffffff)
